<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ 的系统启动画面（用户看到的"点开那一瞬间"）：
      底色用纸色、图标用 App 自己的标记，**不出现小白块/黑屏** —— 这是"像原生 App"的第一印象。
      API 31 以下由 AppTheme 的 windowBackground（同样是纸色）兜着。
    -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSplashScreenBackground">@color/paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/paper</item>
    </style>
</resources>
